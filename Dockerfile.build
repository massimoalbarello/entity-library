FROM alpine:3.21 AS caption
RUN apk add --no-cache build-base cmake linux-headers curl tar
WORKDIR /caption
RUN curl -fsSL https://codeload.github.com/ggml-org/llama.cpp/tar.gz/8172e6577ac2b35de1ec1e5d1c0aaad6c4a2129f -o llama.tar.gz \
 && echo 'c5c6b91e02e6d15af2a5481c3ebadb964f6bcade95b4eec9467a511f6c43b23a  llama.tar.gz' | sha256sum -c - \
 && tar -xzf llama.tar.gz --strip-components=1
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=MinSizeRel -DBUILD_SHARED_LIBS=OFF \
 -DGGML_NATIVE=OFF -DGGML_BLAS=OFF -DGGML_OPENMP=OFF -DLLAMA_CURL=OFF \
 -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF \
 '-DCMAKE_EXE_LINKER_FLAGS=-static -Wl,-z,stack-size=8388608' \
 && cmake --build build --target llama-mtmd-cli -j2 \
 && strip build/bin/llama-mtmd-cli

FROM alpine:3.21 AS build
RUN apk add --no-cache build-base cmake linux-headers curl tar bzip2
WORKDIR /deps
RUN curl -fsSL https://github.com/opencv/opencv/archive/refs/tags/4.10.0.tar.gz -o opencv.tar.gz \
 && echo 'b2171af5be6b26f7a06b1229948bbb2bdaa74fcf5cd097e0af6378fce50a6eb9  opencv.tar.gz' | sha256sum -c - \
 && tar -xzf opencv.tar.gz
RUN cmake -S opencv-4.10.0 -B opencv-build \
 -DCMAKE_BUILD_TYPE=MinSizeRel -DCMAKE_INSTALL_PREFIX=/opt/opencv \
 -DBUILD_SHARED_LIBS=OFF -DBUILD_LIST=core,imgproc,imgcodecs \
 -DBUILD_opencv_gapi=OFF -DWITH_ADE=OFF \
 -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF \
 -DBUILD_opencv_apps=OFF -DBUILD_JAVA=OFF -DBUILD_opencv_python3=OFF \
 -DWITH_IPP=OFF -DWITH_ITT=OFF -DWITH_OPENCL=OFF -DWITH_TBB=OFF \
 -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF -DWITH_GTK=OFF -DWITH_QT=OFF \
 -DWITH_TIFF=OFF -DWITH_WEBP=OFF -DWITH_OPENEXR=OFF -DWITH_JASPER=OFF \
 -DBUILD_JPEG=ON -DBUILD_PNG=ON -DBUILD_ZLIB=ON -DBUILD_PROTOBUF=ON \
 -DCPU_BASELINE=SSE2 -DCPU_DISPATCH= \
 && cmake --build opencv-build -j2 && cmake --install opencv-build
# OpenCV 4.10 exports an unbuilt protobuf target when DNN is excluded. Regenerate
# the installed package with that unused dependency disabled.
RUN cmake -S opencv-4.10.0 -B opencv-build -DBUILD_PROTOBUF=OFF -DWITH_PROTOBUF=OFF \
 && cmake --install opencv-build
WORKDIR /src
COPY vendor ./vendor
COPY apps/backend/engine ./apps/backend/engine
COPY apps/backend/src/models/manifest.json ./apps/backend/src/models/manifest.json
RUN cmake -S apps/backend/engine -B build -DCMAKE_BUILD_TYPE=MinSizeRel \
 -DOpenCV_DIR=/opt/opencv/lib/cmake/opencv4 -DCMAKE_EXE_LINKER_FLAGS=-static -DCLIP_STATIC=ON \
 && cmake --build build -j2 \
 && ctest --test-dir build --output-on-failure \
 && strip build/entity-core
FROM scratch AS binary
COPY --from=build /src/build/entity-core /entity-core

COPY --from=caption /caption/build/bin/llama-mtmd-cli /llama-mtmd-cli
